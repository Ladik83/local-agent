"""Голос: локальное распознавание через whisper.cpp и озвучка через Windows SAPI."""
from __future__ import annotations

import json
import pathlib
import re
import shutil
import subprocess
import threading
import time
import urllib.request
import zipfile

from . import config

GH = "https://api.github.com/repos/ggml-org/whisper.cpp/releases?per_page=30"
MODEL_URL = "https://huggingface.co/ggerganov/whisper.cpp/resolve/main/ggml-base.bin"
UA = {"User-Agent": "LocalAgent/0.4"}
NO_WINDOW = getattr(subprocess, "CREATE_NO_WINDOW", 0)
ENGINES = config.ENGINES_DIR / "whisper"
MODEL = config.DATA_DIR / "models" / "ggml-base.bin"
JOB = {"active": False, "pct": 0.0, "text": "", "error": None}


def find_cli():
    for folder in (ENGINES, config.ENGINES_DIR):
        if not folder.exists():
            continue
        direct = folder / "whisper-cli.exe"
        if direct.exists():
            return str(direct)
        for exe in folder.glob("**/whisper-cli.exe"):
            return str(exe)
    found = shutil.which("whisper-cli") or shutil.which("main.exe")
    return found


def status() -> dict:
    cli = find_cli()
    return {
        "cli": cli,
        "model": str(MODEL) if MODEL.exists() else None,
        "ready": bool(cli and MODEL.exists()),
        "job": dict(JOB),
        "tts": bool(config.load().get("voice_tts")),
    }


def _get(url: str, dest: pathlib.Path, what: str) -> None:
    part = dest.with_name(dest.name + ".part")
    request = urllib.request.Request(url, headers=UA)
    with urllib.request.urlopen(request, timeout=180) as resp, open(part, "wb") as fh:
        total = int(resp.headers.get("Content-Length") or 0)
        done = 0
        while True:
            block = resp.read(1 << 20)
            if not block:
                break
            fh.write(block)
            done += len(block)
            if total:
                JOB["pct"] = round(done * 100 / total, 1)
                JOB["text"] = "%s: %.0f из %.0f МБ" % (what, done / 1048576, total / 1048576)
    part.replace(dest)


def _latest_zip():
    request = urllib.request.Request(GH, headers=UA)
    with urllib.request.urlopen(request, timeout=40) as resp:
        releases = json.loads(resp.read().decode("utf-8"))
    for rel in releases:
        for asset in rel.get("assets", []):
            if asset.get("name") == "whisper-bin-x64.zip":
                return rel.get("tag_name"), asset["browser_download_url"]
    return None, None


def install() -> dict:
    """Скачать бинарник whisper.cpp и модель распознавания."""
    JOB.update(active=True, pct=0.0, text="Ищу сборку whisper.cpp", error=None)
    try:
        tag, url = _latest_zip()
        if not url:
            JOB.update(active=False, error="сборка не найдена")
            return {"ok": False, "error": "не нашёл сборку whisper.cpp"}
        zip_path = config.DOWNLOAD_DIR / ("whisper-%s.zip" % tag)
        if not zip_path.exists():
            _get(url, zip_path, "whisper.cpp %s" % tag)
        ENGINES.mkdir(parents=True, exist_ok=True)
        with zipfile.ZipFile(str(zip_path)) as archive:
            archive.extractall(str(ENGINES))
        try:
            zip_path.unlink()
        except OSError:
            pass
        if not MODEL.exists():
            MODEL.parent.mkdir(parents=True, exist_ok=True)
            _get(MODEL_URL, MODEL, "модель распознавания")
        JOB.update(active=False, pct=100.0, text="Голос готов")
        return {"ok": True, "cli": find_cli(), "model": str(MODEL)}
    except Exception as exc:
        JOB.update(active=False, error=str(exc), text="Ошибка установки голоса")
        return {"ok": False, "error": str(exc)}


def transcribe(wav_path: str, language: str = "ru") -> dict:
    cli = find_cli()
    if not cli or not MODEL.exists():
        return {"ok": False, "error": "голосовой движок не установлен"}
    wav_path = _ensure_16k(str(wav_path))
    out_base = pathlib.Path(wav_path).with_suffix("")
    cmd = [cli, "-m", str(MODEL), "-f", str(wav_path), "-l", language,
           "-nt", "-otxt", "-of", str(out_base)]
    try:
        done = subprocess.run(cmd, capture_output=True, timeout=180, creationflags=NO_WINDOW)
    except (OSError, subprocess.TimeoutExpired) as exc:
        return {"ok": False, "error": str(exc)[:200]}
    text = ""
    txt_file = out_base.with_suffix(".txt")
    try:
        text = txt_file.read_text(encoding="utf-8", errors="replace").strip()
    except OSError:
        text = done.stdout.decode("utf-8", "replace").strip()
    return {"ok": bool(text), "text": re.sub(r"\s+", " ", text), "error": None if text else "не распознал"}


def say(text: str) -> dict:
    """Озвучка ответа через встроенный синтез Windows (офлайн)."""
    clean = re.sub(r"[^\w\s.,!?;:()\-]", " ", str(text or ""))[:600]
    if not clean.strip():
        return {"ok": False, "error": "нечего читать"}
    script = (
        "Add-Type -AssemblyName System.Speech; "
        "$s = New-Object System.Speech.Synthesis.SpeechSynthesizer; "
        "$s.Rate = 0; $s.Speak([Console]::In.ReadToEnd())"
    )
    def worker():
        try:
            proc = subprocess.Popen(["powershell", "-NoProfile", "-Command", script],
                                    stdin=subprocess.PIPE, stdout=subprocess.DEVNULL,
                                    stderr=subprocess.DEVNULL, creationflags=NO_WINDOW)
            proc.communicate(clean.encode("utf-8"), timeout=120)
        except Exception:
            pass
    threading.Thread(target=worker, daemon=True).start()
    return {"ok": True}


def make_test_wav(path: str, phrase: str = "[PERSON_NAME]") -> bool:
    """Синтез фразы в WAV 16 кГц моно — для самопроверки распознавания."""
    script = (
        "Add-Type -AssemblyName System.Speech; "
        "$f = New-Object System.Speech.AudioFormat.SpeechAudioFormatInfo(16000, "
        "[System.Speech.AudioFormat.AudioBitsPerSample]::Sixteen, "
        "[System.Speech.AudioFormat.AudioChannel]::Mono); "
        "$s = New-Object System.Speech.Synthesis.SpeechSynthesizer; "
        "$s.SetOutputToWaveFile('%s', $f); $s.Speak([Console]::In.ReadToEnd()); $s.Dispose()"
    ) % path
    try:
        proc = subprocess.Popen(["powershell", "-NoProfile", "-Command", script],
                                stdin=subprocess.PIPE, stdout=subprocess.DEVNULL,
                                stderr=subprocess.DEVNULL, creationflags=NO_WINDOW)
        proc.communicate(phrase.encode("utf-8"), timeout=90)
    except Exception:
        return False
    return pathlib.Path(path).exists()


def _ensure_16k(path: str) -> str:
    """[PERSON_NAME]: whisper ждёт 16 кГц, а браузер может отдать 48 кГц."""
    import struct
    import wave

    try:
        with wave.open(path, "rb") as wav:
            rate = wav.getframerate()
            channels = wav.getnchannels()
            width = wav.getsampwidth()
            frames = wav.readframes(wav.getnframes())
    except Exception:
        return path
    if rate == 16000 and channels == 1 and width == 2:
        return path

    if width != 2:
        return path
    total = len(frames) // 2
    samples = list(struct.unpack("<" + str(total) + "h", frames[:total * 2]))
    if channels > 1:
        samples = samples[0::channels]
    ratio = 16000.0 / float(rate or 16000)
    count = int(len(samples) * ratio)
    out = []
    for index in range(count):
        position = index / ratio
        left = int(position)
        right = min(left + 1, len(samples) - 1)
        frac = position - left
        value = samples[left] * (1 - frac) + samples[right] * frac
        out.append(int(max(-32768, min(32767, value))))
    target = path.replace(".wav", "_16k.wav")
    with wave.open(target, "wb") as wav:
        wav.setnchannels(1)
        wav.setsampwidth(2)
        wav.setframerate(16000)
        wav.writeframes(struct.pack("<" + str(len(out)) + "h", *out))
    return target
